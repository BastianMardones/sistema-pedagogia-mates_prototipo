# Variables de entorno — Sistema de Gestión Pedagógica
# IMPORTANTE: NO subir este archivo a GitHub con valores reales
# Copiar como .env y completar los valores

# ============================================================
# BASE DE DATOS
# ============================================================
MYSQL_ROOT_PASSWORD=rootpass2026
DB_USER=pedagogia_user
DB_PASSWORD=pedagogia_pass

# ============================================================
# SEGURIDAD JWT
# ============================================================
# Cambiar por una clave aleatoria larga en producción (mín 256 bits)
JWT_SECRET=mi-super-secreto-jwt-para-sistema-pedagogia-2026-cambiar-en-produccion

# ============================================================
# CHATBOT - Google Gemini API Key
# Obtener en: https://aistudio.google.com/apikey (gratuita)
# ============================================================
GOOGLE_API_KEY=tu-google-gemini-api-key-aqui
